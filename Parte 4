uint8_t contador = 0; //variables principales
uint8_t modo = 0;

GPIO_PinState estadoactualSUMA; //variables para botones (lectura y antirrebote)
GPIO_PinState estadoactualRESTA;
GPIO_PinState estadoactualMODO;
GPIO_PinState nuevoestadoSUMA = GPIO_PIN_RESET;
GPIO_PinState nuevoestadoRESTA = GPIO_PIN_RESET;
GPIO_PinState nuevoestadoMODO = GPIO_PIN_RESET;

